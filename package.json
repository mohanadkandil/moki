{
  "name": "moki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moki: an invention-to-launch workshop with coordinated design agents and evidence-backed validation.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "tsx scripts/doctor.ts",
    "openai:check": "tsx scripts/openai-check.ts",
    "environments:setup": "tsx scripts/environments.ts setup",
    "environments:status": "tsx scripts/environments.ts status",
    "environments:stop": "tsx scripts/environments.ts stop",
    "desktops:check": "tsx scripts/desktop-check.ts",
    "desktop:action": "tsx scripts/desktop-action.ts"
  },
  "dependencies": {
    "@daytona/sdk": "0.226.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@openai/agents": "0.21.0",
    "dotenv": "^17.2.0",
    "lucide-react": "^1.61.0",
    "openai": "7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
