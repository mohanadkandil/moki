    "plan": {
      "schema": "moki.plan/1",
      "title": "USB-C RP2040 motor controller",
      "layers": 2,
      "sections": [
        {
          "id": "core",
          "title": "RP2040, USB-C input and 3.3V power",
          "purpose": "Power, flash and run the controller.",
          "insts": [
            "core"
          ],
          "notes": [
            "USB-C sink with 5.1k on both CC pins; ESD, 27 ohm USB resistors, BOOTSEL/RUN buttons, 2MB QSPI and 12MHz crystal included.",
            "AP2112 has 1uF input/output capacitors. Internal 1.1V regulator has 1uF each side. 130mA core peak plus button below 150mA allocation.",
            "Use known regulated USB-C 5V source advertising at least 1.5A; no PD or CC sensing. No expansion headers.",
            "Unreviewed block: RP2040 bare-chip USB motor-controller core."
          ],
          "reference": {
            "lcsc": "C2040",
            "page": 9,
            "quote": "The internal voltage regulator produces a 1.1 V supply from an input of 3.3 V.",
            "datasheetUrl": "https://datasheets.raspberrypi.com/rp2040/hardware-design-with-rp2040.pdf"
          }
        },
        {
          "id": "motor",
          "title": "5V motor driver",
          "purpose": "Drive one small external brushed DC motor.",
          "insts": [
            "motor"
          ],
          "notes": [
            "DRV8833 bridge A to motor connector, unused bridge disabled. GP14 PWM IN1 and GP15 LOW IN2; LOW/LOW coast at boot and stop.",
            "10nF VCP to VM, 2.2uF VINT to GND, 2x10uF ceramic plus 47uF bulk VM; 47k nSLEEP pullup.",
            "0.51 ohm gives about 392mA nominal chopping; 505mA peak reservation is not a hard current limit. Qualify motor startup/stall, EMI and regeneration.",
            "Unreviewed block: DRV8833 single brushed DC motor, qualified5V USB supply."
          ],
          "reference": {
            "lcsc": "C50506",
            "page": 15,
            "quote": "A low-ESR ceramic capacitor must be placed in between the VM and VCP pins.",
            "datasheetUrl": "https://www.ti.com/lit/ds/symlink/drv8833.pdf"
          }
        },
        {
          "id": "button",
          "title": "Single control button",
          "purpose": "Start, stop and change speed.",
          "insts": [
            "button"
          ],
          "notes": [
            "Active-low GP0 with 10k pullup; software debounce. Short presses cycle OFF,40%,70%,100%,OFF. Hold 800ms stops and consumes release. Power-up OFF.",
            "Unreviewed block: GP0 application button."
          ]
        }
      ],
