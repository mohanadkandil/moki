import assert from 'node:assert/strict';
import {mkdtemp,readFile,rm,writeFile} from 'node:fs/promises';
import {request} from 'node:http';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {scryptSync} from 'node:crypto';
import {preview} from 'vite';
import {createBoardService} from '../../../../../server/board-api.ts';
import {createAppsServer} from '/home/sogo/projects/sogo-apps/src/app.ts';
import {MokiCapability,fetchMoki} from '/home/sogo/projects/sogo-apps/src/moki.ts';
const temp=await mkdtemp(join(tmpdir(),'moki-link-check-'));
const host='moki.fixture.example',origin='https://'+host;
const capability=new MokiCapability(join(temp,'private'),join(temp,'ram'));
await capability.prepare(host);
const secret=(await readFile(join(temp,'private/moki-capability.env'),'utf8')).trim().split('=')[1];
process.env.MOKI_BASE_PATH='/app/moki/';process.env.MOKI_PUBLIC_HOST=host;process.env.MOKI_BOARD_API_TOKEN=secret;
const {default:configure}=await import('../../../../../vite.config.ts');
const config=configure({command:'serve',mode:'production',isPreview:true});
const board=createBoardService({jobsRoot:join(temp,'jobs')});
const plugins=(config.plugins??[]).flat(Infinity).filter((p:any)=>p&&p.name!=='moki-board-api');
plugins.push({name:'isolated-board-fixture',configurePreviewServer(server:any){server.middlewares.use((req:any,res:any,next:any)=>void board.handle(req,res,next));}});
let server:Awaited<ReturnType<typeof preview>>|undefined,gateway:ReturnType<typeof createAppsServer>|undefined;
const checks:{name:string;pass:boolean}[]=[];
const check=async(name:string,fn:()=>Promise<void>)=>{await fn();checks.push({name,pass:true});};
try{
 server=await preview({...config,configFile:false,plugins,preview:{...config.preview,port:8847,strictPort:true}});
 const base='http://127.0.0.1:8847';
 await check('preview uses production base, serves Studio and Lab HTML',async()=>{for(const route of ['/studio','/lab']){const r=await fetchMoki(base+'/app/moki'+route,{headers:{Host:host}});assert.equal(r.status,200);const html=await r.text();assert(html.includes('/app/moki/assets/'));assert(!html.includes('/@vite/client'));}});
 await check('unknown Host is refused on HTML, API and redirect',async()=>{for(const tail of ['/studio','/api/board/jobs',''])assert.equal((await fetchMoki(base+'/app/moki'+tail,{headers:{Host:'attacker.example'},redirect:'manual'})).status,403);});
 await check('preview refuses workshop, filesystem, HMR, study and source paths',async()=>{for(const tail of ['/api/runs','/api/projects','/@fs/etc/passwd','/@vite/client','/studies/','/src/main.tsx','/architecture/'])assert.equal((await fetchMoki(base+'/app/moki'+tail,{headers:{Host:host}})).status,404,tail);});
 await check('prefixed board API requires its own server capability',async()=>{const url=base+'/app/moki/api/board/jobs';assert.equal((await fetchMoki(url,{headers:{Host:host}})).status,401);assert.equal((await fetchMoki(url,{headers:{Host:host,'X-Moki-Capability':'wrong'}})).status,401);const r=await fetchMoki(url,{headers:{Host:host,'X-Moki-Capability':secret}});assert.equal(r.status,200);assert.deepEqual(await r.json(),[]);});
 await check('board Origin check remains active with original public Host',async()=>{const url=base+'/app/moki/api/board/jobs';for(const [Origin,status]of [[origin,400],['https://attacker.example',403]]as const){const r=await fetchMoki(url,{method:'POST',headers:{Host:host,Origin,'X-Moki-Capability':secret,'Content-Type':'application/json'},body:new TextEncoder().encode('{}').buffer});assert.equal(r.status,status);}});
 const salt='fixture',hash=salt+':'+scryptSync('fixture-password',salt,64).toString('hex');
 gateway=createAppsServer({passwordHash:hash,sessionSecret:'fixture-secret-at-least-thirty-two-chars',publicUrl:origin,dataDir:join(temp,'private'),runtimeDir:join(temp,'ram'),units:{async state(unit){return unit==='moki.service'?'active':'inactive';},async start(){throw Error('No live lifecycle permitted');},async stop(){throw Error('No live lifecycle permitted');}}});
 const port=await gateway.listen(0),gate='http://127.0.0.1:'+port,session=gateway.auth.session();
 const headers={Host:host,Origin:origin,Cookie:'sogo_apps_session='+session};
 await check('real gateway and preview serve authenticated Studio, Lab and JS assets',async()=>{const r=await fetchMoki(gate+'/app/moki/studio',{headers});assert.equal(r.status,200);const html=await r.text(),asset=html.match(/src="(\/app\/moki\/assets\/[^\"]+\.js)"/);assert(asset);assert.equal((await fetchMoki(gate+asset[1],{headers})).status,200);assert.equal((await fetchMoki(gate+'/app/moki/lab',{headers})).status,200);});
 await check('real gateway requires authentication on HTML, assets, API and raw path escapes',async()=>{for(const route of ['/app/moki/studio','/app/moki/assets/missing.js','/app/moki/api/board/jobs']){const r=await fetchMoki(gate+route,{headers:{Host:host},redirect:'manual'});assert([303,401].includes(r.status));}const status=await new Promise<number>((resolve,reject)=>{const r=request(gate,{path:'/app/moki/assets/%2e%2e/secret',headers},res=>{res.resume();resolve(res.statusCode!);});r.on('error',reject);r.end();});assert.equal(status,400);});
 await check('real gateway token injection satisfies board API without browser secret',async()=>{let r=await fetchMoki(gate+'/app/moki/api/board/jobs',{headers:{...headers,'X-Moki-Capability':'browser-forgery'}});assert.equal(r.status,200);assert.deepEqual(await r.json(),[]);r=await fetchMoki(gate+'/app/moki/api/board/jobs',{method:'POST',headers:{...headers,'Content-Type':'application/json'},body:new TextEncoder().encode('{}').buffer});assert.equal(r.status,400);assert(!(await r.text()).includes(secret));r=await fetchMoki(gate+'/app/moki/api/board/jobs',{method:'POST',headers:{...headers,Origin:'https://attacker.example'},body:new TextEncoder().encode('{}').buffer});assert.equal(r.status,403);});
 await check('real gateway redirects bare app and blocks workshop API',async()=>{const r=await fetchMoki(gate+'/app/moki',{headers,redirect:'manual'});assert.equal(r.status,303);assert.equal(r.headers.get('location'),'/app/moki/studio');assert.equal((await fetchMoki(gate+'/app/moki/api/runs',{headers})).status,404);});
 const result={checkedAt:new Date().toISOString(),scope:'Actual Vite production preview and actual Apps gateway; isolated board job root, fixture authentication and mocked units; no live app switch',checks};await writeFile(new URL('./preview-check.json',import.meta.url),JSON.stringify(result,null,2));console.log(JSON.stringify(result,null,2));
}finally{await gateway?.close();await board.close();await new Promise<void>(resolve=>server?server.httpServer.close(()=>resolve()):resolve());await rm(temp,{recursive:true,force:true});}
