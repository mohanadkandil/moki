          }
        },
        {
          "id": "motor",
          "title": "DRV8833 DC motor",
          "purpose": "BridgeA PWM, current-sense and motor connector",
          "insts": [
            "motor"
          ],
          "notes": [
            "GP14 and GP15 support PWM. Motor is external and unqualified.",
            "205mA typical/505mA peak supply reservation is an author estimate, not a stall guarantee.",
            "Single bridgeA adaptation per TI pages9–11; bridgeB inputs/sense grounded, outputs unused. Layout figure is a reference, not an exact application schematic."
          ],
          "reference": {
            "lcsc": "C50506",
            "datasheetUrl": "https://www.ti.com/lit/ds/symlink/drv8833.pdf",
            "page": 15,
            "quote": "Recommended Layout Example",
            "figure": "10"
          }
        }
      ],
      "app": {
        "source": "#include <Arduino.h>\n#include \"pins.h\"\nvoid setup() {\n  digitalWrite(PIN_MOTOR_IN1, LOW);\n  digitalWrite(PIN_MOTOR_IN2, LOW);\n  pinMode(PIN_MOTOR_IN1, OUTPUT);\n  pinMode(PIN_MOTOR_IN2, OUTPUT);\n  delay(2);\n  analogWrite(PIN_MOTOR_IN1, 0);\n  analogWrite(PIN_MOTOR_IN2, 0);\n}\nvoid loop() { delay(20); }\n"
      }
    }
