        {
          "id": "screen",
          "title": "3.3V SSD1306 module cable header",
          "purpose": "Connector contract only: JST SH1mm1GND2+3.3V3SCL4SDA, external3.3V SSD1306 I2C0x3C module. No bare OLED IC or selected module is claimed. External device must stay within50mA reserve; actual module consumption/polarity/address must be verif",
          "insts": [
            "screen"
          ],
          "notes": [
            "Added by hand."
          ]
        }
      ],
      "app": {
        "source": "#include <Arduino.h>\n#include \"pins.h\"\n#include <Wire.h>\n#include <Adafruit_GFX.h>\n#include <Adafruit_SSD1306.h>\n\nAdafruit_SSD1306 screen(128, 64, &Wire, -1);\nbool screenReady = false;\nbool checked = false;\nunsigned long lastUpdate = 0;\n\nvoid setup() {\n  Serial.begin(115200);\n  Serial.println(\"SSD1306 support; existing firmware was not supplied.\");\n  Wire.begin(PIN_SCREEN_I2C_DISPLAY_SDA, PIN_SCREEN_I2C_DISPLAY_SCL);\n  Wire.setTimeOut(25);\n  Serial.println(\"Screen requires a 3.3V-compatible 0x3C module and correct cable polarity; header budget is 50mA.\");\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  if (checked && (unsigned long)(now - lastUpdate) < 1000) return;\n  checked = true;\n  lastUpdate = now;\n\n  Wire.beginTransmission(0x3C);\n  if (Wire.endTransmission() != 0) {\n    Serial.println(\"Screen unavailable: no I2C response at 0x3C.\");\n    screenReady = false;\n    return;\n  }\n  if (!screenReady) {\n    if (!screen.begin(SSD1306_SWITCHCAPVCC, 0x3C, true, false)) {\n      Serial.println(\"Screen initialization failed.\");\n      return;\n    }\n    screenReady = true;\n    screen.setTextSize(1);\n    screen.setTextColor(SSD1306_WHITE);\n    screen.setTextWrap(false);\n    Serial.println(\"SSD1306 initialized at 0x3C.\");\n  }\n  screen.clearDisplay();\n  screen.setCursor(0, 0);\n  screen.println(\"ESP32-S3 USB-C\");\n  screen.println(\"SSD1306 display\");\n  screen.println();\n  screen.print(\"Uptime: \");\n  screen.print(now / 1000);\n  screen.println(\" s\");\n  screen.display();\n}\n"
      }
    },
