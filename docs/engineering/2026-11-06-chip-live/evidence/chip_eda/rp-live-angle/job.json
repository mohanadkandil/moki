      "app": {
        "source": "#include <Arduino.h>\n#include \"pins.h\"\n\nconst uint8_t duties[] = {0, 102, 179, 255};\nuint8_t speedStep = 0;\nbool rawButton = HIGH, stableButton = HIGH, longHandled = false;\nunsigned long startedAt, changedAt = 0, pressedAt = 0;\n\nvoid setSpeed(uint8_t step) {\n  speedStep = step;\n  analogWrite(PIN_MOTOR_IN1, duties[step]);\n  if (step == 0) digitalWrite(PIN_MOTOR_IN1, LOW);\n  Serial.print(\"Motor percent: \");\n  Serial.println(step == 0 ? 0 : step == 1 ? 40 : step == 2 ? 70 : 100);\n}\n\nvoid setup() {\n  digitalWrite(PIN_MOTOR_IN1, LOW);\n  digitalWrite(PIN_MOTOR_IN2, LOW);\n  pinMode(PIN_MOTOR_IN1, OUTPUT);\n  pinMode(PIN_MOTOR_IN2, OUTPUT);\n  startedAt = millis();\n  pinMode(PIN_BUTTON_SIGNAL, INPUT_PULLUP);\n  Serial.begin(115200);\n  Serial.println(\"Motor OFF; using core-default PWM frequency.\");\n}\n\nvoid loop() {\n  unsigned long now = millis();\n  if (now - startedAt < 2) return;\n\n  bool reading = digitalRead(PIN_BUTTON_SIGNAL);\n  if (reading != rawButton) {\n    rawButton = reading;\n    changedAt = now;\n  }\n  if (rawButton != stableButton && now - changedAt >= 30) {\n    stableButton = rawButton;\n    if (stableButton == LOW) {\n      pressedAt = changedAt;\n      longHandled = false;\n    } else if (!longHandled) {\n      if (changedAt - pressedAt >= 800) setSpeed(0);\n      else setSpeed((speedStep + 1) % 4);\n    }\n  }\n  if (stableButton == LOW && rawButton == LOW && !longHandled &&\n      now - pressedAt >= 800) {\n    setSpeed(0);\n    longHandled = true;\n  }\n}\n"
      }
    }
  },
